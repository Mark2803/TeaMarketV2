NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://tea_market:change_me@localhost:5432/tea_market?schema=public"
MODERATOR_API_KEY=change_me
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=your-bucket
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$CHANGE_ME_SALT$CHANGE_ME_HASH
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Transactional email (Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=change_me
SMTP_PASSWORD=change_me
MAIL_FROM=info@tea-master-team.ru
MAIL_FROM_NAME=Чайный Мастер
