NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://tea_market:change_me@localhost:5432/tea_market?schema=public"

# Публичные адреса магазина
PUBLIC_SITE_URL=https://tea-master-team.ru
STOREFRONT_URL=http://localhost:5173

# S3 (Yandex Object Storage) для изображений
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=your-bucket
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$CHANGE_ME_SALT$CHANGE_ME_HASH
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Подпись ссылок на гостевые заказы (если не задано — используется ADMIN_SESSION_SECRET)
GUEST_ORDER_ACCESS_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
# Почта для кодов раздела «Менеджмент»
MANAGEMENT_EMAIL=info@tea-master-team.ru

# Transactional email (Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=change_me
SMTP_PASSWORD=change_me
MAIL_FROM=info@tea-master-team.ru
MAIL_FROM_NAME=Чайный Мастер

# Telegram-уведомления
TELEGRAM_BOT_TOKEN=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# Яндекс Доставка
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_SOURCE_STATION_ID=
YANDEX_DELIVERY_TEST_TOKEN=
YANDEX_DELIVERY_TEST_STATION_ID=
# Только для локальной разработки
TRACKING_SIMULATION_ENABLED=false

# Путь к собранному index.html фронтенда для SEO-страниц (необязательно)
SEO_HTML_TEMPLATE_PATH=
