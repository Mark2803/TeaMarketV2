{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Tea Market",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:demo:seed": "tsx prisma/demo-seed.ts",
    "db:demo:clear": "tsx prisma/demo-clear.ts",
    "db:legacy:clear": "tsx prisma/legacy-test-clear.ts",
    "test:e2e": "tsx tests/e2e-smoke.ts",
    "db:demo:fix-images": "tsx prisma/fix-demo-images.ts",
    "admin:hash-password": "tsx scripts/hash-admin-password.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
