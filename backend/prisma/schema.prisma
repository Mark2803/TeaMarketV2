/// Настройки Email-канала уведомлений. SMTP-секреты хранятся только в .env backend.
model notification_channel_settings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel     String   @unique @db.VarChar(32)
  is_enabled  Boolean  @default(true)
  sender_name String?  @db.VarChar(255)
  sender_from String?  @db.VarChar(320)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

/// Редактируемые Email-шаблоны автоматических уведомлений.
model notification_templates {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_key  String   @unique @db.VarChar(100)
  name       String   @db.VarChar(255)
  subject    String   @db.VarChar(500)
  body       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// Email-рассылка администратора.
model notification_campaigns {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(255)
  audience_type String    @default("all") @db.VarChar(32)
  customer_ids  Json?
  subject       String    @db.VarChar(500)
  body          String
  channels      Json      @default("[\"email\"]")
  status        String    @default("draft") @db.VarChar(32)
  sent_at       DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at])
}

/// Журнал фактических Email-отправок.
model notification_deliveries {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id   String?   @db.Uuid
  campaign_id   String?   @db.Uuid
  event_key     String?   @db.VarChar(100)
  recipient     String    @db.VarChar(500)
  subject       String    @db.VarChar(500)
  body          String
  status        String    @default("pending") @db.VarChar(32)
  error_message String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  sent_at       DateTime? @db.Timestamptz(6)

  @@index([created_at(sort: Desc)])
  @@index([customer_id, created_at(sort: Desc)])
  @@index([status])
}

/// Согласие покупателя на маркетинговые Email. Сервисные письма отделены от маркетинговых.
model notification_preferences {
  customer_id     String   @id @db.Uuid
  email_marketing Boolean  @default(false)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
}

/// Анонимная сессия посетителя для собственной аналитики магазина.
model analytics_sessions {
  id               String   @id @db.Uuid
  visitor_id       String   @db.Uuid
  customer_id      String?  @db.Uuid
  started_at       DateTime @default(now()) @db.Timestamptz(6)
  last_activity_at DateTime @default(now()) @db.Timestamptz(6)
  landing_path     String
  referrer         String?
  source           String   @default("direct") @db.VarChar(100)
  medium           String?  @db.VarChar(100)
  campaign         String?  @db.VarChar(255)
  content          String?  @db.VarChar(255)
  term             String?  @db.VarChar(255)
  device_type      String?  @db.VarChar(32)
  events           analytics_events[]
  attributions     analytics_order_attributions[]

  @@index([started_at])
  @@index([visitor_id, started_at])
  @@index([source, started_at])
  @@index([customer_id, started_at])
}

/// Только необходимые поведенческие события: страницы, товары, корзина, checkout.
model analytics_events {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String   @db.Uuid
  visitor_id String   @db.Uuid
  customer_id String? @db.Uuid
  event_type String   @db.VarChar(32)
  product_id String?  @db.Uuid
  variant_id String?  @db.Uuid
  quantity   Int?
  path       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  session    analytics_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([event_type, created_at])
  @@index([product_id, event_type, created_at])
  @@index([session_id, created_at])
}

/// Связывает заказ с той сессией, из которой он был оформлен.
model analytics_order_attributions {
  order_id   String   @id @db.Uuid
  session_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  session    analytics_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
}
