  is_active                Boolean  @default(false)
  inviter_bonus            Decimal  @default(200) @db.Decimal(12, 2)
  invitee_discount_percent Decimal  @default(10) @db.Decimal(5, 2)
  min_order_amount         Decimal  @default(1000) @db.Decimal(12, 2)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)
