/// Ручные связи между товарами, назначаемые модератором магазина.
/// relation_type:
/// related — связанные товары;
/// similar — похожие товары.
model product_relations {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id         String   @db.Uuid
  related_product_id String   @db.Uuid
  relation_type      String   @db.VarChar(32)
  sort_order         Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  product         products @relation("ProductRelations", fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_relations_product_fk")
  related_product products @relation("RelatedProducts", fields: [related_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_relations_related_product_fk")

  @@unique([product_id, related_product_id, relation_type], map: "product_relations_unique")
  @@index([product_id, relation_type, sort_order], map: "product_relations_product_idx")
  @@index([related_product_id], map: "product_relations_related_product_idx")
}

/// Одноразовые коды подтверждения телефона.
/// В базе хранится только SHA-256 хеш кода.
model auth_codes {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String?   @db.VarChar(32)
  email        String?   @db.VarChar(320)
  channel      String    @default("phone") @db.VarChar(16)
  code_hash    String    @db.VarChar(64)
  expires_at   DateTime  @db.Timestamptz(6)
  attempts     Int       @default(0)
  max_attempts Int       @default(5)
  used_at      DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone, created_at(sort: Desc)], map: "auth_codes_phone_created_idx")
  @@index([phone, expires_at], map: "auth_codes_active_idx", where: raw("(used_at IS NULL)"))
  @@index([email, created_at(sort: Desc)], map: "auth_codes_email_created_idx")
  @@index([email, expires_at], map: "auth_codes_email_active_idx", where: raw("(used_at IS NULL)"))
}

/// Сессии авторизованных покупателей.
/// Клиент получает случайный токен, а в базе хранится только его SHA-256 хеш.
model auth_sessions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id  String    @db.Uuid
  token_hash   String    @unique(map: "auth_sessions_token_unique") @db.VarChar(64)
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  customers    customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_sessions_customer_fk")

  @@index([customer_id, created_at(sort: Desc)], map: "auth_sessions_customer_idx")
  @@index([token_hash, expires_at], map: "auth_sessions_active_idx", where: raw("(revoked_at IS NULL)"))
}

/// Публичные статьи о чае для Главной и раздела материалов.
model articles {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String    @unique(map: "articles_slug_uq") @db.VarChar(255)
  title                String    @db.VarChar(255)
  excerpt              String
  content              String
  cover_url            String?
  cover_alt            String?   @db.VarChar(500)
  reading_time_minutes Int       @default(5)
  status               String    @default("draft") @db.VarChar(32)
  is_featured          Boolean   @default(false)
  sort_order           Int       @default(0)
  published_at         DateTime? @db.Timestamptz(6)
  seo_title            String?   @db.VarChar(255)
  seo_description      String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, published_at], map: "articles_status_published_idx")
  @@index([is_featured, sort_order], map: "articles_featured_sort_idx")
}

/// Управляемые Hero-плашки Главной, каждая ведёт в тематическую подборку.
model home_banners {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collection_id String      @db.Uuid
  eyebrow       String?     @db.VarChar(120)
  title         String      @db.VarChar(255)
  subtitle      String?
  image_url     String?
  image_alt     String?     @db.VarChar(500)
  is_active     Boolean     @default(true)
  sort_order    Int         @default(0)
  starts_at     DateTime?   @db.Timestamptz(6)
  ends_at       DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  collections   collections @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "home_banners_collection_fk")

  @@index([is_active, sort_order], map: "home_banners_active_sort_idx")
  @@index([collection_id], map: "home_banners_collection_idx")
  @@index([starts_at, ends_at], map: "home_banners_dates_idx")
}


model promotions {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  description      String?
  discount_type    String   @db.VarChar(32)
  scope            String   @default("order") @db.VarChar(32)
  target_ids       Json?
  value            Decimal  @default(0) @db.Decimal(12, 2)
  buy_quantity     Int?
  get_quantity     Int?
  min_order_amount Decimal  @default(0) @db.Decimal(12, 2)
  priority         Int      @default(0)
  audience_type    String   @default("all") @db.VarChar(32)
  customer_ids     Json?
  activation_type  String   @default("automatic") @db.VarChar(32)
  promo_code_id    String?  @db.Uuid
  is_stackable     Boolean  @default(false)
  usage_limit      Int?
  per_customer_limit Int    @default(1)
  is_active        Boolean  @default(true)
  starts_at        DateTime? @db.Timestamptz(6)
  ends_at          DateTime? @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active, starts_at, ends_at])
  @@index([priority])
}

model promo_codes {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String   @unique @db.VarChar(100)
  name               String   @db.VarChar(255)
  discount_type      String   @db.VarChar(32)
