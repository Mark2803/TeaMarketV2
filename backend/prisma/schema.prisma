  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active, starts_at, ends_at])
}

model loyalty_settings {
  id                Int      @id @default(1)
  is_active         Boolean  @default(false)
  earn_percent      Decimal  @default(3) @db.Decimal(5, 2)
  max_spend_percent Decimal  @default(30) @db.Decimal(5, 2)
  min_order_amount  Decimal  @default(0) @db.Decimal(12, 2)
  bonus_lifetime_days Int?
  min_spend_points  Decimal  @default(0) @db.Decimal(12, 2)
  allow_with_promotions Boolean @default(true)
  allow_with_promo_codes Boolean @default(true)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
